# Firecrawl (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# OpenAI
OPENAI_API_KEY=
# Model is configurable so you can switch without code changes
OPENAI_MODEL=

# LinkedIn app (Share on LinkedIn product, scope w_member_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Local SQLite file
DATABASE_URL=file:./data/app.db

# Scheduling
TIMEZONE=Asia/Kolkata
MAX_POSTS_PER_WEEK=4

# Set true only if your LinkedIn app has the Community Management API product (needed for comments)
LINKEDIN_AUTO_COMMENT=false
